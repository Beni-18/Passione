{
  "contract_field_mapping": {
    "duration_minutes": "runtime (real, modeled)",
    "genre": "genre -> primary_genre (first listed genre only)",
    "language": "original_language",
    "tags": "keywords",
    "title": "title",
    "upload_time": "release_date (reframed, see plan \u00a75)"
  },
  "display_names": {
    "duration_minutes": "duration_minutes",
    "duration_missing": "duration_missing",
    "has_tags": "has_tags",
    "is_friday_release": "is_friday_release",
    "is_holiday_season": "is_holiday_season",
    "language": "language",
    "primary_genre": "genre",
    "release_dayofweek": "release_dayofweek",
    "release_month": "release_month",
    "release_year": "release_year",
    "tag_count": "tag_count",
    "title_caps_ratio": "title_caps_ratio",
    "title_has_number": "title_has_number",
    "title_has_punctuation_hook": "title_has_punctuation_hook",
    "title_length": "title_length",
    "title_word_count": "title_word_count"
  },
  "excluded_leakage_columns": [
    "vote_count",
    "revenue",
    "vote_average",
    "status"
  ],
  "excluded_tier2_columns": [
    "budget",
    "production_companies",
    "production_countries",
    "spoken_languages",
    "cast",
    "crew",
    "overview"
  ],
  "features": [
    {
      "display_name": "genre",
      "dtype": "categorical",
      "name": "primary_genre",
      "source_field": "genres",
      "status": "modeled",
      "transform": "first element, else 'unknown'"
    },
    {
      "display_name": "language",
      "dtype": "categorical",
      "name": "language",
      "source_field": "original_language",
      "status": "modeled",
      "transform": "passthrough, lowercased, else 'unknown'"
    },
    {
      "display_name": "release_month",
      "dtype": "categorical",
      "name": "release_month",
      "source_field": "release_date",
      "status": "modeled",
      "transform": "month, zero-padded, else 'unknown'"
    },
    {
      "display_name": "release_dayofweek",
      "dtype": "categorical",
      "name": "release_dayofweek",
      "source_field": "release_date",
      "status": "modeled",
      "transform": "day name, else 'unknown'"
    },
    {
      "display_name": "duration_minutes",
      "dtype": "numeric",
      "name": "duration_minutes",
      "source_field": "runtime",
      "status": "modeled",
      "transform": "passthrough (real, modeled)"
    },
    {
      "display_name": "release_year",
      "dtype": "numeric",
      "name": "release_year",
      "source_field": "release_date",
      "status": "modeled",
      "transform": "year"
    },
    {
      "display_name": "tag_count",
      "dtype": "numeric",
      "name": "tag_count",
      "source_field": "keywords",
      "status": "modeled",
      "transform": "count"
    },
    {
      "display_name": "title_length",
      "dtype": "numeric",
      "name": "title_length",
      "source_field": "title",
      "status": "modeled",
      "transform": "len()"
    },
    {
      "display_name": "title_word_count",
      "dtype": "numeric",
      "name": "title_word_count",
      "source_field": "title",
      "status": "modeled",
      "transform": "whitespace token count"
    },
    {
      "display_name": "title_caps_ratio",
      "dtype": "numeric",
      "name": "title_caps_ratio",
      "source_field": "title",
      "status": "modeled",
      "transform": "uppercase letters / letters"
    },
    {
      "display_name": "duration_missing",
      "dtype": "bool",
      "name": "duration_missing",
      "source_field": "runtime",
      "status": "modeled",
      "transform": "isna()"
    },
    {
      "display_name": "is_holiday_season",
      "dtype": "bool",
      "name": "is_holiday_season",
      "source_field": "release_date",
      "status": "modeled",
      "transform": "month in {11,12}"
    },
    {
      "display_name": "is_friday_release",
      "dtype": "bool",
      "name": "is_friday_release",
      "source_field": "release_date",
      "status": "modeled",
      "transform": "dayofweek == 4"
    },
    {
      "display_name": "has_tags",
      "dtype": "bool",
      "name": "has_tags",
      "source_field": "keywords",
      "status": "modeled",
      "transform": "count > 0"
    },
    {
      "display_name": "title_has_punctuation_hook",
      "dtype": "bool",
      "name": "title_has_punctuation_hook",
      "source_field": "title",
      "status": "modeled",
      "transform": "'!' or '?' present"
    },
    {
      "display_name": "title_has_number",
      "dtype": "bool",
      "name": "title_has_number",
      "source_field": "title",
      "status": "modeled",
      "transform": "contains a digit"
    }
  ],
