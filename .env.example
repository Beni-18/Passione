# Every env var the backend reads, via core/config.py. No real values here —
# copy to .env and fill in locally; .env is gitignored.

APP_NAME=Passioné
API_HOST=0.0.0.0
API_PORT=8000

# JSON array of allowed browser origins for the UI.
CORS_ORIGINS=["http://localhost:8080"]

MODELS_DIR=models
DATA_DIR=data

# Readiness gate — see docs/API_CONTRACT.md. Gates /health and whether
# /predict is even attempted. Grounding of an individual prediction is
# mlcore's own call, not a backend threshold.
MIN_ROC_AUC=0.65

# TMDB enrichment (optional; /predict works without it).
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
ENRICHMENT_TIMEOUT_SECONDS=3.0
ENRICHMENT_MAX_RETRIES=2
ENRICHMENT_ENABLED=false
